# dependencies
/node_modules
/.pnp
.pnp.*
# web/ is its own pnpm workspace root (onlyBuiltDependencies), so a local
# install writes a stray lockfile; the root workspace lockfile is canonical.
/pnpm-lock.yaml
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
e2e-results/
playwright-report/
test-results/

# production
/dist
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# typescript
*.tsbuildinfo

# E2E test artifacts
e2e/report/
e2e/screenshots/
